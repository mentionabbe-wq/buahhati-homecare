# Salin menjadi .env di folder yang sama dengan docker-compose.build.yml
# lalu isi nilainya. Berkas .env TIDAK ikut ke dalam image maupun ke Git.

# Port yang dibuka di host CasaOS
APP_PORT=3600

# Database
POSTGRES_USER=buahhati
POSTGRES_PASSWORD=ganti-password-database-ini
POSTGRES_DB=buahhati

# Keamanan — buat nilai acak, jangan pakai contoh ini
# openssl rand -hex 32
AUTH_SECRET=
# openssl rand -hex 24
CRON_SECRET=

# Aplikasi
NEXT_PUBLIC_APP_NAME=BuahHati Home Care
NEXT_PUBLIC_APP_URL=http://buahhati.local:3600
BUSINESS_TZ_OFFSET=420
TZ=Asia/Jakarta

# Data awal (hanya dipakai bila database masih kosong)
SEED_DATABASE=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!

# WhatsApp: mock | fonnte | wablas | meta
WHATSAPP_PROVIDER=mock
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_SENDER=

# Payment gateway: mock | midtrans | xendit
PAYMENT_PROVIDER=mock
