# ---------------------------------------------------------------------------
# Database (PostgreSQL untuk produksi)
# Untuk demo offline tanpa Postgres: `npm run db:use:sqlite`
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/buahhati?schema=public"

# ---------------------------------------------------------------------------
# Auth — WAJIB diganti di produksi (minimal 32 karakter acak)
# Contoh generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
SESSION_MAX_AGE_DAYS=7

# ---------------------------------------------------------------------------
# Aplikasi
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="BuahHati Home Care"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BUSINESS_TZ_OFFSET=420

# ---------------------------------------------------------------------------
# WhatsApp provider: mock | fonnte | wablas | meta
# mock = pesan hanya dicatat di database (aplikasi tetap jalan tanpa API)
# ---------------------------------------------------------------------------
WHATSAPP_PROVIDER="mock"
WHATSAPP_API_URL=""
WHATSAPP_API_KEY=""
WHATSAPP_SENDER=""

# ---------------------------------------------------------------------------
# Payment gateway (modul siap dikembangkan): mock | midtrans | xendit
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER="mock"
PAYMENT_SERVER_KEY=""
PAYMENT_CLIENT_KEY=""
PAYMENT_IS_PRODUCTION="false"

# ---------------------------------------------------------------------------
# Cron / reminder worker
# ---------------------------------------------------------------------------
CRON_SECRET="ganti-dengan-string-acak"

# ---------------------------------------------------------------------------
# Seed (jangan dipakai di produksi)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="Admin123!"
